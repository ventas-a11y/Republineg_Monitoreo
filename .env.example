APP_NAME=Monitoreo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Para abrir el entorno de desarrollo desde otra máquina de la red interna:
# SERVER_HOST hace que `php artisan serve` escuche en todas las interfaces y
# DEV_SERVER_HOST es la IP de esta máquina que Vite anuncia para assets y HMR.
# APP_URL debe usar esa misma IP (p. ej. http://192.168.1.10:8000).
# SERVER_HOST=0.0.0.0
# DEV_SERVER_HOST=192.168.1.10

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Servicios locales: `docker compose up -d` (ver compose.override.yaml).
# Genera cada secreto vacío una sola vez, por ejemplo con: openssl rand -hex 24

# PostgreSQL. La app usa el rol DML (DB_USERNAME); las migraciones usan el rol
# dueño del esquema: php artisan migrate --database=pgsql_owner
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=monitoreo
DB_USERNAME=monitoreo_app
DB_PASSWORD=
DB_OWNER_USERNAME=monitoreo_owner
DB_OWNER_PASSWORD=
# Solo lo usa el contenedor de Postgres para crear la base y los roles.
POSTGRES_SUPERUSER_PASSWORD=

SESSION_DRIVER=database
# 30 min de inactividad y 8 h como máximo (docs/SEGURIDAD.md, Q51).
SESSION_LIFETIME=30
SESSION_ABSOLUTE_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción (HTTPS): SESSION_SECURE_COOKIE=true y SESSION_COOKIE=__Host-monitoreo_session.
# El prefijo __Host- exige HTTPS, así que no se usa en desarrollo por http.

# Solo producción: IP o red de Traefik, separadas por comas. Nunca "*".
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# Valkey (compatible con Redis): colas de Horizon y caché.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Garage (S3 interno, ADR-0003). El contenedor crea el bucket y esta clave al arrancar.
#   AWS_ACCESS_KEY_ID:     echo "GK$(openssl rand -hex 16)"
#   AWS_SECRET_ACCESS_KEY: openssl rand -hex 32
#   GARAGE_RPC_SECRET:     openssl rand -hex 32
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage
AWS_BUCKET=monitoreo-capturas
AWS_ENDPOINT=http://127.0.0.1:3900
AWS_USE_PATH_STYLE_ENDPOINT=true
GARAGE_RPC_SECRET=

VITE_APP_NAME="${APP_NAME}"
